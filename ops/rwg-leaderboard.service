[Unit]
Description=RetroWebGames global leaderboard API
After=network.target mariadb.service
Requires=mariadb.service

[Service]
Type=simple
User=site_rwg
Group=site_rwg
# Never execute the service from /projects: that checkout is intentionally
# writable by the deploy workflow. The installer stages a root-owned copy here.
WorkingDirectory=/var/lib/rwg-leaderboard/app
EnvironmentFile=/etc/rwg/leaderboard.env
ExecStart=/usr/bin/node /var/lib/rwg-leaderboard/app/server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
