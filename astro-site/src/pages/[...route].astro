---
import LocalizedDocument from '../components/LocalizedDocument.astro';
import { PAGES } from '../lib/render-page.mjs';

export function getStaticPaths() {
  return PAGES.flatMap(page => ['it','en'].map(locale => ({
    params: { route: locale === 'it' ? (page.route || undefined) : `en${page.route ? `/${page.route}` : ''}` },
    props: { pageId: page.id, locale }
  })));
}

const { pageId, locale } = Astro.props;
---
<LocalizedDocument pageId={pageId} locale={locale} />
